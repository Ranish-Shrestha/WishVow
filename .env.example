# Server only. Use a pooled Neon URL on Vercel or a local PostgreSQL URL.
DATABASE_URL=
# Optional direct PostgreSQL URL for the migration CLI.
DATABASE_MIGRATION_URL=
# Optional. Inferred from the URL hostname when omitted.
DATABASE_DRIVER=
# Generate with: node -p "require('node:crypto').randomBytes(32).toString('base64url')"
AUTH_SECRET=
APP_URL=http://localhost:3000
# Optional comma-separated hostnames for Next.js development assets.
WISHVOW_DEV_ORIGINS=

# Use local for development or vercel_blob with a private Vercel Blob store.
STORAGE_PROVIDER=local
BLOB_READ_WRITE_TOKEN=
# Optional development-only image directory.
WISHVOW_LOCAL_STORAGE_DIR=

# Choose local for development or resend for outbound email.
EMAIL_PROVIDER=local
RESEND_API_KEY=
EMAIL_FROM=
# Optional. Local messages contain private links and should not be shared.
WISHVOW_LOCAL_MAIL_DIR=

# Production requires verified host emails. Enable this locally to test the flow.
HOST_EMAIL_VERIFICATION=false
# Public address for privacy requests. Required by the beta release preflight.
PRIVACY_CONTACT_EMAIL=
